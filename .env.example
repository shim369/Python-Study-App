# Gemini APIキー(Google AI Studio で無料発行: https://aistudio.google.com/apikey)
# 未設定でもアプリは動作し、AI機能のみ無効になります
# 注意: 無料枠では送信した内容(コード等)がGoogleの製品改善に利用されます
GEMINI_API_KEY=
# 使用モデル(省略時: gemini-3.8-flash)。回数を多く使いたいなら gemini-3.5-flash-lite など
GEMINI_MODEL=gemini-3.8-flash
# SQLiteの保存先(省略時: data/app.db)
STUDY_APP_DB_PATH=data/app.db
